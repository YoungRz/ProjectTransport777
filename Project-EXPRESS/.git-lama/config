[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
	autocrlf = true
[remote "origin"]
	url = https://github.com/YoungRz/Backend-Express.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	vscode-merge-base = origin/main
	merge = refs/heads/main
[branch "feature-backend"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/feature-backend
